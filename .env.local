# ============================================================
# TradeAI Local Development Configuration
# ============================================================

APP_ENV=development
APP_DEBUG=true

DATABASE_URL=postgresql+asyncpg://tradeai:tradeai@localhost:5432/tradeai

REDIS_URL=redis://127.0.0.1:6379/0

VECTOR_DB_URL=http://localhost:6333

JWT_SECRET_KEY=change-me-in-production-must-be-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

MARKET_DATA_QUOTE_TTL_SECONDS=30
MARKET_DATA_HISTORY_TTL_SECONDS=300
MARKET_DATA_INDICES_TTL_SECONDS=60
MARKET_DATA_OPTIONS_TTL_SECONDS=30

OPENAI_API_KEY=

UPSTOX_API_KEY=
UPSTOX_API_SECRET=

ZERODHA_API_KEY=
ZERODHA_API_SECRET=

CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1